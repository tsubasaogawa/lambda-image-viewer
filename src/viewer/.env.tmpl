# S3 static domain name. This is the domain where the static files are hosted.
ORIGIN_DOMAIN=

# Lambda viewer domain name. This is the domain where the viewer Lambda function is hosted.
VIEWER_DOMAIN=

# AWS region. This is the AWS region where the resources are hosted.
REGION=

# ARN of the Secrets Manager secret containing the CloudFront RSA private key.
PRIVATE_SIGNING_KEY_SECRET_ARN=

# Public key ID from the Terraform output.
CLOUDFRONT_SIGNING_KEY_ID=
